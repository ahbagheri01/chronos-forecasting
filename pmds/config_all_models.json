{
  "base_config": "config.json",
  "run": {
    "name": "11_12_3_rep",
    "output_dir": "pmds/results/11_12_3_rep",
    "log_dir": "pmds/results/11_12_3_rep/logs"
  },
  "enabled_datasets": [
    "chronos_m1_yearly",
    "chronos_m4_hourly",
    "chronos_weather",
    "external_national_illness",
    "external_traffic",
    "external_psm",
    "chronos_m3_quarterly",
    "chronos_car_parts",
    "chronos_nn5_weekly",
    "official_elexon_demand",
    "official_usgs_streamflow",
    "official_bls_macro"
  ],
  "models": [
    {
      "name": "chronos_t5_tiny",
      "type": "chronos",
      "enabled": true,
      "foundation_model": true,
      "stochastic": true,
      "params": {
        "model_id": "amazon/chronos-t5-tiny",
        "device": "cpu",
        "torch_dtype": "float32",
        "num_samples": 100,
        "temperature": 1.0,
        "top_k": 50,
        "top_p": 1.0
      }
    },
    {
      "name": "chronos_t5_mini",
      "type": "chronos",
      "enabled": true,
      "foundation_model": true,
      "stochastic": true,
      "params": {
        "model_id": "amazon/chronos-t5-mini",
        "device": "cuda",
        "torch_dtype": "bfloat16",
        "num_samples": 100,
        "temperature": 1.0,
        "top_k": 50,
        "top_p": 1.0
      }
    },
    {
      "name": "chronos_t5_small",
      "type": "chronos",
      "enabled": true,
      "foundation_model": true,
      "stochastic": true,
      "params": {
        "model_id": "amazon/chronos-t5-small",
        "device": "cuda",
        "torch_dtype": "bfloat16",
        "num_samples": 100,
        "temperature": 1.0,
        "top_k": 50,
        "top_p": 1.0
      }
    },
    {
      "name": "chronos_t5_base",
      "type": "chronos",
      "enabled": true,
      "foundation_model": true,
      "stochastic": true,
      "params": {
        "model_id": "amazon/chronos-t5-base",
        "device": "cuda",
        "torch_dtype": "bfloat16",
        "num_samples": 100,
        "temperature": 1.0,
        "top_k": 50,
        "top_p": 1.0
      }
    },
    {
      "name": "chronos_t5_large",
      "type": "chronos",
      "enabled": false,
      "foundation_model": true,
      "stochastic": true,
      "params": {
        "model_id": "amazon/chronos-t5-large",
        "device": "cuda",
        "torch_dtype": "bfloat16",
        "num_samples": 100,
        "temperature": 1.0,
        "top_k": 50,
        "top_p": 1.0
      }
    },
    {
      "name": "timesfm_2_5_200m",
      "type": "timesfm",
      "enabled": true,
      "foundation_model": true,
      "stochastic": true,
      "params": {
        "model_id": "google/timesfm-2.5-200m-pytorch",
        "revision": "1d95242",
        "max_context": 512,
        "max_horizon": 256,
        "normalize_inputs": true,
        "torch_compile": false,
        "local_files_only": false
      }
    },
    {
      "name": "moirai_2_0_small",
      "type": "moirai2",
      "enabled": true,
      "foundation_model": true,
      "stochastic": true,
      "params": {
        "model_id": "Salesforce/moirai-2.0-R-small",
        "revision": "30f43ff",
        "device": "cpu",
        "max_context": 512
      }
    },
    {
      "name": "seasonal_naive",
      "type": "seasonal_naive",
      "enabled": true,
      "stochastic": true,
      "params": {
        "use_dataset_seasonality": true,
        "seasonality": 1
      }
    },
    {
      "name": "arima_2_1_2",
      "type": "statsmodels_arima",
      "enabled": true,
      "stochastic": true,
      "params": {
        "order": [2, 1, 2],
        "seasonal_order": [0, 0, 0, 0],
        "trend": null,
        "enforce_stationarity": false,
        "enforce_invertibility": false,
        "maxiter": 200
      }
    },
    {
      "name": "auto_arima",
      "type": "auto_arima",
      "enabled": true,
      "stochastic": true,
      "params": {
        "information_criterion": "aic",
        "min_p": 0,
        "max_p": 2,
        "min_d": 0,
        "max_d": 1,
        "min_q": 0,
        "max_q": 2,
        "min_P": 0,
        "max_P": 0,
        "min_D": 0,
        "max_D": 0,
        "min_Q": 0,
        "max_Q": 0,
        "max_order": 5,
        "seasonal": false,
        "use_dataset_seasonality": true,
        "seasonality": 1,
        "trend": "c",
        "enforce_stationarity": false,
        "enforce_invertibility": false,
        "maxiter": 100,
        "selection_max_samples": 5000
      }
    },
    {
      "name": "prophet",
      "type": "prophet",
      "enabled": true,
      "stochastic": true,
      "params": {
        "growth": "linear",
        "seasonality_mode": "additive",
        "yearly_seasonality": "auto",
        "weekly_seasonality": "auto",
        "daily_seasonality": "auto",
        "changepoint_prior_scale": 0.05,
        "seasonality_prior_scale": 10.0,
        "interval_width": 0.8,
        "uncertainty_samples": 200,
        "mcmc_samples": 0
      }
    },
    {
      "name": "deepar",
      "type": "deepar",
      "enabled": true,
      "stochastic": true,
      "params": {
        "context_length_multiplier": 2.0,
        "min_context_length": 8,
        "hidden_size": 40,
        "num_layers": 2,
        "dropout_rate": 0.1,
        "learning_rate": 0.001,
        "weight_decay": 0.00000001,
        "batch_size": 16,
        "num_batches_per_epoch": 10,
        "num_parallel_samples": 100,
        "prediction_samples": 100,
        "temporary_directory": "/tmp",
        "trainer": {
          "max_epochs": 50,
          "accelerator": "cpu",
          "devices": 1,
          "enable_checkpointing": true,
          "logger": false,
          "enable_progress_bar": false
        }
      }
    }
  ]
}
